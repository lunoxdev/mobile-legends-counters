---
import MainLayout from "@layouts/Layout.astro";
import HeroList from "@components/HeroList";
import RotatePhone from "@components/RotatePhone.astro";
---

<MainLayout>
  <div class="relative h-dvh w-screen flex flex-row">
    <RotatePhone />

    <main
      class="flex-1 px-2 portrait:hidden md:portrait:flex landscape:flex md:landscape:block"
    >
      <HeroList client:load />
    </main>
  </div>
</MainLayout>
